# Скопируйте в .env:  cp .env.example .env   и измените значения

# --- PostgreSQL ---
POSTGRES_USER=seismo
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=seismo

# --- Первый администратор (создаётся при первом запуске, если пользователей нет) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=Администратор

# --- Приложение ---
APP_PORT=8080
SESSION_TTL_HOURS=12
COOKIE_SECURE=false        # true — только если открываете сайт по HTTPS
MAX_UPLOAD_MB=50
OCR_ENABLED=true
OCR_LANG=rus+eng
